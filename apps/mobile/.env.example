# このファイルをコピーして .env.local を作り、値を入れる（.env.local は gitignore 済み）
#   cp .env.example .env.local

# 目標ロードマップの AI 生成に使う Gemini API キー
# 取得: https://aistudio.google.com/apikey
# 未設定でもアプリは動く（generateRoadmap がモックのツリーを返す）
EXPO_PUBLIC_GEMINI_API_KEY=

# Supabase（既存。未設定なら supabase.tsx のデフォルト値が使われる）
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
